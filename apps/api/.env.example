# ── calibrEAT uptime pinger — environment ───────────────────────────
# The pinger runs as a Cloudflare Worker (wrangler.uptime.toml). Production
# values are Worker secrets, set with:
#   npx wrangler secret put <NAME> -c wrangler.uptime.toml
# Never put real values in this file or in git.

# Resend API key used to send the up/down alert email.
RESEND_API_KEY=

# Alert recipient and sender (sender must be a domain verified in Resend).
ALERT_TO=
ALERT_FROM=calibrEAT Uptime <no-reply@calibreat.co.uk>

# Bearer token for the pinger's HTTP admin route.
ADMIN_TOKEN=
