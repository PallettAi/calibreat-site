    "check:activity": "node --experimental-strip-types scripts/check-activity-burn.mjs",
    "check:week": "node --experimental-strip-types scripts/check-week-bank.mjs",
    "check:budget": "node --experimental-strip-types scripts/check-day-budget.mjs",
    "check:routines": "node --experimental-strip-types scripts/check-routines.mjs",
    "check:dates": "node --experimental-strip-types scripts/check-dates.mjs",
    "check:reminders": "node --experimental-strip-types scripts/check-reminders.mjs",
    "check:streak": "node --experimental-strip-types scripts/check-streak.mjs",
    "check:share": "node --experimental-strip-types scripts/check-share.mjs",
    "check:share-daily": "node --experimental-strip-types scripts/check-daily-share.mjs",
    "check:muscles": "node --experimental-strip-types scripts/check-muscles.mjs",
    "check:workout": "node --experimental-strip-types scripts/check-workout.mjs",
