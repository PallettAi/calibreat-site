  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "release:apk": "npx eas-cli@latest build --platform android --profile production",
    "hotfix:preview": "npx eas-cli@latest update --channel preview --platform android",
    "hotfix:production": "npx eas-cli@latest update --channel production --platform android",
    "credentials": "npx eas-cli@latest credentials --platform android",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/run-checks.mjs",
    "verify": "npm run lint && npm run check",
    "check:math": "node --experimental-strip-types scripts/check-math.mjs",
    "check:diary": "node --experimental-strip-types scripts/check-diary.mjs",
    "check:fasting": "node --experimental-strip-types scripts/check-fasting.mjs",
