    "check:meals": "node --experimental-strip-types scripts/check-meals.mjs",
    "check:export": "node --experimental-strip-types scripts/check-export.mjs",
    "check:restore": "node --experimental-strip-types scripts/check-restore.mjs",
    "check:import": "node --experimental-strip-types scripts/check-import-diary.mjs",
    "check:bmi": "node --experimental-strip-types scripts/check-bmi-gauge.mjs",
    "check:ocr": "node --experimental-strip-types scripts/check-ocr.mjs",
    "check:recipe": "node --experimental-strip-types scripts/check-recipe.mjs",
    "check:barcode": "node --experimental-strip-types scripts/check-barcode.mjs",
