{
  "expo": {
    "name": "calibrEAT",
    "slug": "calibreat",
    "version": "0.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calibreat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.calibreat.app"
    },
    "android": {
      "package": "com.calibreat.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#0A1019",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_STEPS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1019",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "calibrEAT uses the camera to read food barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F9D55",
          "defaultChannel": "weigh-in"
        }
      ],
      "expo-sharing",
      "react-native-health-connect",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CalibreatSmall",
              "label": "calibrEAT",
              "description": "Calories left today",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 0
            },
            {
              "name": "CalibreatMedium",
              "label": "calibrEAT",
              "description": "Calories, protein, water and fasting",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "calibrEAT reads a photo of a nutrition label on this device to fill in the pack's values. Photos are never uploaded.",
          "cameraPermission": "calibrEAT uses the camera to photograph nutrition labels and read food barcodes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2eb3df97-e80d-4d39-8dbc-a54fba7e41d6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2eb3df97-e80d-4d39-8dbc-a54fba7e41d6",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
