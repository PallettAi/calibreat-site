{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LICENSE_API_URL": "https://api.calibreat.co.uk",
        "EXPO_PUBLIC_USDA_API_KEY": "DEMO_KEY"
      }
    },
    "production": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LICENSE_API_URL": "https://api.calibreat.co.uk",
        "EXPO_PUBLIC_USDA_API_KEY": "DEMO_KEY"
      }
    }
  }
}
